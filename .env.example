# Only needed to run agents:warm or to use live mode locally. The deployed
# public demo needs none of these; it replays the committed cache.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Live mode (owner only): a visitor-entered passphrase that unlocks real model
# calls for a new upload on the public site.
LIVE_MODE_PASSPHRASE=

# Upstash Redis (Vercel Marketplace), used for the live-mode cache in
# production. Not needed for local dev, which uses a file-system cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
